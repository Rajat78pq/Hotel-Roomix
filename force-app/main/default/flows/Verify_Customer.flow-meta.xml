                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Valid_Customer_Res</targetReference>
            </connector>
            <label>Valid Customer</label>
        </rules>
    </decisions>
    <description>This Flow will Verify is the customer is valid or not.</description>
    <environments>Default</environments>
